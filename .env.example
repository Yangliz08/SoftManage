# Environment example for SoftManage
# Copy to .env and adjust values as needed

# MySQL
MYSQL_ROOT_PASSWORD=root

# RabbitMQ
RABBITMQ_DEFAULT_USER=guest
RABBITMQ_DEFAULT_PASS=guest

# Docker Hub placeholder (for production compose)
DOCKERHUB_USERNAME=yourdockerhubuser

# Application ports (optional override)
FRONTEND_PORT=3002
GATEWAY_PORT=8200
AUTH_PORT=8201
TASK_PORT=8202
WORKFLOW_PORT=8203
REPORT_PORT=8204
NOTIFICATION_PORT=8205
AUDIT_PORT=8206
AI_PORT=8207

